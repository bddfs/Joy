    {
      "text": "\u7B2C 1 \u65E5 \u00B7 \u516C\u5171\u534F\u4F5C\u70B9 \u5EFA\u8BBE\u5B8C\u6210\uFF1B\u6B21\u65E5\u8D77\u53EF\u8425\u4E1A\u3001\u5C01\u63A7\u4E0E\u4EA4\u63A5\u3002",
      "fontSize": 17,
      "characters": 32
    },
    {
      "text": "\u5EFA\u6210 \u516C\u5171\u534F\u4F5C\u70B9\uFF1A\u672C\u65E5\u4E0D\u8BA1\u8425\u4E1A\u3001\u5C01\u63A7\u6216\u4EA4\u63A5\uFF0C\u6B21\u65E5\u8D77\u5B89\u6392\u9A7B\u7AD9\u751F\u6548\u3002",
