    {
      "text": "\u7B2C 1 \u65E5 \u00B7 \u4F59\u989D 11 \u2192 11",
      "fontSize": 15,
      "characters": 18
    },
    {
      "text": "\u7B2C 1 \u65E5 \u00B7 \u767D\u6986\u533B\u9662 \u4FDD\u5B88\u8C03\u67E5\u53D6\u5F97\u8BB0\u5F55\uFF1A\u503C\u73ED\u8BB0\u5F55\uFF1A\u4EAE\u706F\u540E\u641C\u67E5\u3001\u5C01\u88C5\u6837\u672C\u6B63\u5E38\u5B8C\u6210\uFF1B\u6478\u9ED1\u641C\u67E5\u51FA\u73B0\u60CA\u6270\u3002",
      "fontSize": 17,
      "characters": 51
    },
    {
      "text": "\u767D\u6986\u533B\u9662\uFF1A\u5386\u53F2\u6216\u53EF\u9760\u8BB0\u5F55\u5DF2\u5E26\u56DE\uFF0C\u65E5\u7EC8\u5F52\u6863\u540E\u6B21\u65E5\u53EF\u7528\u4E8E\u5224\u65AD\u3002",
      "fontSize": 17,
      "characters": 29
    },
    {
      "text": "02  \u8BC1\u636E\u5F52\u6863\u4E0E\u5408\u540C\u4EA4\u4ED8",
      "fontSize": 20,
      "characters": 13
    },
    {
      "text": "\u7B2C 1 \u65E5 \u00B7 \u4F59\u989D 11 \u2192 13",
      "fontSize": 15,
      "characters": 18
    },
    {
      "text": "\u8BC1\u636E\u6309\u5B9E\u9645\u5DF2\u53D6\u5F97\u5185\u5BB9\u5F52\u6863\uFF1B\u672C\u9636\u6BB5\u6CA1\u6709\u65B0\u589E\u73B0\u91D1\u5165\u8D26\u3002",
      "fontSize": 17,
      "characters": 25
    },
    {
      "text": "03  \u5DE5\u7A0B\u4E0E\u5904\u7F6E\u5B8C\u6210",
      "fontSize": 20,
      "characters": 11
    },
    {
      "text": "\u7B2C 1 \u65E5 \u00B7 \u4F59\u989D 13 \u2192 13",
