    },
    {
      "text": "\u8C03\u67E5 \u00D72  \u00B7  \u53D6\u5F97\u5F53\u524D\u4F4D\u7F6E\u4E00\u6761\u5C1A\u672A\u53D6\u5F97\u7684\u53EF\u9760\u7EBF\u7D22\u3002",
      "fontSize": 19,
      "characters": 28
    },
    {
      "text": "\u641C\u67E5 \u00D72  \u00B7  \u641C\u7D22\u5F53\u524D\u5BB9\u5668\uFF1B\u672C\u623F\u672C\u51FA\u52E4\u6B63\u5E38\u641C\u67E5 \u002B1\uFF0C\u53EF\u62D2\u7EDD\u5165\u5305\u3002",
