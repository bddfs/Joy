    },
    {
      "text": "\u62A4\u8EAB \u00D71  \u00B7  \u62A4\u7B26 \u002B1\uFF0C\u4E0A\u9650 3\u3002",
      "fontSize": 19,
      "characters": 21
    },
    {
      "text": "\u75BE\u8D70 \u00D71  \u00B7  \u6CBF\u5408\u6CD5\u901A\u8DEF\u6700\u591A\u79FB\u52A8 2 \u683C\uFF0C\u9010\u683C\u7ED3\u7B97\uFF1B\u4FDD\u7559\u6A21\u4EFF\u53C2\u8003\u3002",
      "fontSize": 19,
      "characters": 36
    },
    {
      "text": "\u6A21\u4EFF \u00D71  \u00B7  \u5728\u5F53\u524D\u4F4D\u7F6E\u6267\u884C\u53C2\u8003\u57FA\u7840\u6307\u4EE4\uFF1B\u4E0D\u8BA1\u6B63\u5E38\u641C\u67E5\u884C\u4E3A\uFF0C\u6BCF\u51FA\u52E4\u8017\u5C3D\u3002",
      "fontSize": 19,
      "characters": 39
    },
    {
      "text": "\u5C01\u88C5 \u00D71  \u00B7  \u5C01\u88C5\u4E00\u4EF6\u5DF2\u7ECF\u6EE1\u8DB3\u6536\u5BB9\u6761\u4EF6\u7684\u80CC\u5305\u7269\u54C1\u3002",
