    },
    {
      "text": "\u70B9\u706F \u00D71  \u00B7  \u672C\u8F6E\u7167\u660E\uFF0C\u5F02\u52A8 \u22121\u3002",
      "fontSize": 19,
      "characters": 21
    },
    {
      "text": "\u4F11\u606F \u00D71  \u00B7  \u5FC3\u5FD7 \u002B2\uFF1B\u6BCF\u4E2A\u623F\u95F4\u5B9E\u4F8B\u6700\u591A 2 \u6B21\uFF0C\u4E0E\u6A21\u4EFF\u5171\u4EAB\u3002",
