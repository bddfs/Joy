{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Joy: build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/Joy.csproj"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Joy: tests",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "${workspaceFolder}/Tests/Joy.Tests.csproj"],
      "problemMatcher": "$msCompile",
      "group": "test"
    }
  ]
}
